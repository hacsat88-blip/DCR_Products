{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx next:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(gh pr:*)",
      "Bash(gh run *)",
      "WebSearch",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/validate-commit-msg.ps1",
            "statusMessage": "コミットメッセージ規約チェック",
            "if": "Bash(git commit *)"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/validate.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/deploy.ps1 -Check",
            "statusMessage": "カタログ検証 + デプロイチェック",
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/enforce-gate-chain.ps1 -RequiredPhase ship",
            "statusMessage": "ゲートチェーン: ship gate 確認",
            "if": "Bash(git push *)"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/validate.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/deploy.ps1 -Check",
            "statusMessage": "カタログ検証 + デプロイチェック",
            "if": "Bash(git push *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/enforce-p3.ps1 -Operation delete",
            "statusMessage": "P3ゲート: 破壊的操作チェック",
            "if": "Bash(rm *)|Bash(del *)|Bash(Remove-Item *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/gate-advance-post-commit.ps1",
            "statusMessage": "ゲート状態: コミット後自動進行",
            "async": true,
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/session-capture.ps1",
            "statusMessage": "セッション学習キャプチャ",
            "async": true,
            "if": "Bash(git push *)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/detect-scope-drift.ps1",
            "statusMessage": "スコープドリフト検知",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/mem-search-hook.ps1",
            "statusMessage": "メモリ検索"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}\"/tools/lib/gate-auto-init.ps1",
            "statusMessage": "ゲート状態チェック",
            "async": true
          }
        ]
      }
    ]
  }
}
