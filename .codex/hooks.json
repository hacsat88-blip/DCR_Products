{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit *)",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./validate.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1 -Check",
            "statusMessage": "Hook gate: running validate and deploy check before git commit"
          }
        ]
      },
      {
        "matcher": "Bash(git push *)",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./validate.ps1 && pwsh -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1 -Check",
            "statusMessage": "Hook gate: running validate and deploy check before git push"
          }
        ]
      }
    ]
  }
}
