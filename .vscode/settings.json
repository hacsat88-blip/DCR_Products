{
  // サトシ開発ワークスペース — VS Code / Cursor 共通（エージェントの検索・ウォッチ負荷を抑えつつ DCR 運用に合わせる）
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "editor.inlineSuggest.enabled": true,
  "redhat.telemetry.enabled": true,
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "search.exclude": {
    ".claude/agents/**": true,
    ".codex/agents/**": true,
    "docs/dcr/plans/archive/**": true,
    "docs/dcr/specs/archive/**": true,
    "**/.dexter/**": true,
    "**/.superpowers/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true,
    ".windsurf/**": true,
    "**/.cursor/**": true
  },
  "files.exclude": {
    ".claude/agents/**": true,
    ".codex/agents/**": true,
    "docs/dcr/plans/archive": true,
    "docs/dcr/specs/archive": true
  },
  "files.watcherExclude": {
    ".claude/agents/**": true,
    ".codex/agents/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true,
    ".windsurf/**": true,
    "**/.cursor/**": true
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "[powershell]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // commit/push はエージェントに任せっぱなしにしない（誤コミット・誤プッシュの抑止）。ステージのみ自動承認。
  "chat.tools.terminal.autoApprove": {
    "git add": true
  },
  // GPG 未設定時にコミット横の鍵アイコンでブロックされないよう署名を無効化（global commit.gpgsign=false と併用）
  "git.enableCommitSigning": false
}
