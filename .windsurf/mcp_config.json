{
  "mcpServers": {
    "opencode-bridge": {
      "command": "python",
      "args": ["<REPO_ROOT>/tools/mcp-servers/opencode-bridge/server.py"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "<REPO_ROOT>"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": ""
      }
    }
  }
}
