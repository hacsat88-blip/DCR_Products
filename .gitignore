# Generated triad mirrors are tracked so a clean checkout can pass deploy -Check.
# Edit .ai/ first and regenerate; do not edit mirrors directly.

codex_Product/

# Nested git repos (unregistered submodules)
prototypes/blue-planet-globe/

# Personal local overrides (not shared)
.claude/local/
.claude/settings.local.json

# Per-session gate state (managed at runtime, not committed)
.ai/routing/state/gate-state.json

# Router decision log (per-session telemetry, not committed)
.ai/routing/state/router-decisions.jsonl

# P3 force-override log (per-session telemetry, not committed)
.ai/routing/state/p3-force-log.jsonl

# Deprecation dashboard snapshot (regenerated, not committed)
docs/deprecation-status.json

# Token budget snapshot (regenerated, not committed; baseline goes elsewhere)
docs/token-budget.json

# Git worktrees (local workspaces, not committed)
.worktrees/

# Temporary output files
output/
portfolio_snapshot_*.md

# Windows reserved device names
NUL
CON
PRN
AUX
COM[1-9]
LPT[1-9]
