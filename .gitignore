# Obsidian (root)
.obsidian/

# Obsidian (templates)
templates/obsidian/.obsidian/plugins/
templates/obsidian/.obsidian/themes/
templates/obsidian/.obsidian/workspace.json
templates/obsidian/.obsidian/workspace-mobile.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Removed from Git (local delete when unlocked); prevents accidental re-add
/Product/cyber-stock-dashboard/

# Node
node_modules/
npm-debug.log*
**/.next/

# 一時ファイル
*.tmp
*.bak
*~

# 秘密情報
.env
.env.*
*.key
*.pem

# Runtime artifacts (not source of truth)
**/.dexter/
**/.superpowers/
/autotrader.xlsm
/~$autotrader.xlsm

# Generated adapter outputs (not source of truth)
/.cursor/
/.windsurf/
/.codex/agents/
/.claude/agents/

# Ignore all .dcr directories by default (runtime/session files)
**/.dcr/

# Track only the repository-level Manus Pattern source files
!/.dcr/
/.dcr/*
!/.dcr/config.json
!/.dcr/templates/
!/.dcr/templates/*.md
!/.dcr/phase.yaml
!/.dcr/intent-log-schema.md
!/.dcr/compositions.yaml
!/.dcr/adversarial-pairs.yaml
!/.dcr/registry.yaml
# intent-log.jsonl and intent-weights.md are local runtime data (not tracked)
codex_Product/

# Nested git repos (unregistered submodules)
prototypes/blue-planet-globe/

# Personal local overrides (not shared)
CLAUDE.local.md
.claude/local/
.claude/settings.local.json

# Per-session gate state (managed at runtime, not committed)
.ai/kernel/gate-state.json

# Router decision log (per-session telemetry, not committed)
.ai/kernel/router-decisions.jsonl

# Deprecation dashboard snapshot (regenerated, not committed)
docs/deprecation-status.json

# Token budget snapshot (regenerated, not committed; baseline goes elsewhere)
docs/token-budget.json
