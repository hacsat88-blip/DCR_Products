# Ignore all .dcr directories by default (runtime/session files)
**/.dcr/

# Track only the repository-level Manus Pattern source files
!/.dcr/
/.dcr/*
!/.dcr/config.json
!/.dcr/templates/
!/.dcr/templates/*.md
codex_Product/

# Nested git repos (unregistered submodules)
prototypes/blue-planet-globe/

# Personal local overrides (not shared)
CLAUDE.local.md
.claude/settings.json
.claude/settings.local.json
