{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DCR Manifest Schema",
    "description": "Compiled manifest of rules, skills, and agents with distribution targets",
    "type": "object",
    "required": [
        "rules",
        "skills",
        "agents"
    ],
    "properties": {
        "rules": {
            "type": "array",
            "description": "All rules with their target distributions",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "path",
                    "targets"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Rule name (filename without .md)"
                    },
                    "path": {
                        "type": "string",
                        "description": "Relative path to rule file"
                    },
                    "targets": {
                        "type": "array",
                        "description": "Tools that should receive this rule",
                        "items": {
                            "enum": [
                                "vscode",
                                "claude",
                                "codex",
                                "zed"
                            ]
                        },
                        "minItems": 1
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional: rule description from frontmatter"
                    }
                }
            }
        },
        "skills": {
            "type": "array",
            "description": "All skills with their target distributions",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "path",
                    "targets"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Skill name (directory name)"
                    },
                    "path": {
                        "type": "string",
                        "description": "Relative path to SKILL.md"
                    },
                    "targets": {
                        "type": "array",
                        "description": "Tools that should receive this skill",
                        "items": {
                            "enum": [
                                "vscode",
                                "claude",
                                "codex",
                                "zed"
                            ]
                        },
                        "minItems": 1
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional: skill description from frontmatter"
                    }
                }
            }
        },
        "agents": {
            "type": "array",
            "description": "All agents with their target distributions",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "path",
                    "targets"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Agent name"
                    },
                    "path": {
                        "type": "string",
                        "description": "Relative path to agent file (.md or .toml)"
                    },
                    "targets": {
                        "type": "array",
                        "description": "Tools that should receive this agent (typically codex, claude)",
                        "items": {
                            "enum": [
                                "codex",
                                "claude"
                            ]
                        },
                        "minItems": 1
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional: agent description from frontmatter"
                    }
                }
            }
        }
    }
}
